{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "blueprint",
      "camelcase": "Blueprint",
      "title": "Blueprint",
      "scope": "source.blueprint",
      "file-types": [
        "blp"
      ],
      "injection-regex": "^blueprint$",
      "class-name": "TreeSitterBlueprint"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPL",
    "description": "Gtk Blueprint",
    "authors": [
      {
        "name": "PaladinDev",
        "email": "paladindev@altlinux.org"
      }
    ],
    "links": {
      "repository": "https://github.com/SpikedPaladin/tree-sitter-blueprint"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}